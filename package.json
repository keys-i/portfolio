    "react-draggable": "^4.7.1",
    "react-onclickoutside": "^6.13.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "engines": {
